# Store these values as the GitHub production environment secret PRODUCTION_ENV_FILE.
# Keep production secrets out of git and replace every example domain before deployment.

POSTGRES_DB=ysheng
POSTGRES_USER=ysheng
POSTGRES_PASSWORD=change-this-database-password

SEED_ADMIN_EMAIL=admin@ysheng.local
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_DATA_ENABLED=true
ASPNETCORE_ENVIRONMENT=Production

# Google Document AI. Provision the processors in asia-southeast1 and place the
# least-privilege service-account credential on the VPS outside the release tree.
OCR_PROVIDER=GoogleDocumentAi
GOOGLE_DOCUMENT_AI_PROJECT_ID=replace-with-google-cloud-project-id
GOOGLE_DOCUMENT_AI_LOCATION=asia-southeast1
GOOGLE_DOCUMENT_AI_DEFAULT_PROCESSOR_ID=replace-with-enterprise-ocr-processor-id
GOOGLE_DOCUMENT_AI_INVOICE_PROCESSOR_ID=
GOOGLE_DOCUMENT_AI_EXPENSE_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS_HOST_PATH=/opt/ysheng/shared/google-document-ai.json

# Generate each independently with: openssl rand -hex 32
# Store them only in the production secret; do not reuse the browser token as the OTLP key.
ASPIRE_DASHBOARD_BROWSER_TOKEN=change-this-dashboard-browser-token
ASPIRE_DASHBOARD_OTLP_API_KEY=change-this-dashboard-otlp-api-key

POSTGRES_PORT=5432
API_PORT=5000
FRONTOFFICE_PORT=3000
BACKOFFICE_PORT=3001

PUBLIC_API_BASE_URL=https://portal.example.com
FRONTOFFICE_ORIGIN=https://www.example.com
BACKOFFICE_ORIGIN=https://portal.example.com

# DNS A/AAAA records for these hostnames must point to the Shinjiru server before deployment.
API_DOMAIN=portal.example.com
FRONTOFFICE_DOMAIN=www.example.com
BACKOFFICE_DOMAIN=portal.example.com
TLS_EMAIL=admin@example.com
