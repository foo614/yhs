{
	email {$TLS_EMAIL}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	encode zstd gzip
}

{$FRONTOFFICE_DOMAIN} {
	import security_headers
	reverse_proxy frontoffice:3000
}

{$BACKOFFICE_DOMAIN} {
	import security_headers

	# Aspire's login component dynamically imports this script from an absolute
	# root path. Rebase only that known dashboard asset before it reaches the
	# internal /ops adapter; do not expose a general root-path dashboard route.
	@ops-login-script path /Components/Pages/Login.razor.js
	handle @ops-login-script {
		uri replace /Components/Pages/Login.razor.js /ops/Components/Pages/Login.razor.js
		reverse_proxy ops-proxy:8080
	}

	# The dashboard imports these modules with root-relative URLs even when
	# rendered beneath /ops. Rebase only the known dashboard-owned modules so
	# the back-office fallback remains the owner of every other root route.
	@ops-theme-script path /js/app-theme.js
	handle @ops-theme-script {
		uri replace /js/app-theme.js /ops/js/app-theme.js
		reverse_proxy ops-proxy:8080
	}

	@ops-fluent-script path /_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js
	handle @ops-fluent-script {
		uri replace /_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js /ops/_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js
		reverse_proxy ops-proxy:8080
	}

	# Aspire renders both metric views, so the graph module, Plotly bundle, and
	# hidden table module all load from absolute root paths. Recover only those
	# three dashboard assets through the /ops adapter.
	@ops-metrics-scripts path /js/app-metrics.js /js/plotly-basic-2.35.2.min.js /Components/Controls/Chart/MetricTable.razor.js
	handle @ops-metrics-scripts {
		rewrite * /ops{uri}
		reverse_proxy ops-proxy:8080
	}

	# Aspire 13 emits these dashboard routes as root-relative URLs. Redirect the
	# browser to /ops before dashboard authentication so its /ops-scoped cookie
	# is sent, while escaped trace or log links cannot reach the back-office SPA.
	@ops-dashboard-route path /resources /resources/* /consolelogs /consolelogs/* /structuredlogs /structuredlogs/* /traces /traces/* /metrics /metrics/*
	handle @ops-dashboard-route {
		redir * /ops{uri} temporary
	}

	@api path /api/*
	handle @api {
		# Caddy is the public ingress. Its reverse proxy overwrites client-supplied
		# X-Forwarded-For before forwarding to the private API container.
		reverse_proxy api:8080
	}

	@health path /health /health/*
	handle @health {
		reverse_proxy api:8080
	}

	@ops-root path /ops
	redir @ops-root /ops/ permanent
	handle /ops/* {
		reverse_proxy ops-proxy:8080
	}

	handle {
		reverse_proxy backoffice:3001
	}
}
