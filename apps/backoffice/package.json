{
  "name": "@ysheng/backoffice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3001",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3001",
    "lint": "tsc --noEmit",
    "test": "vitest run src",
    "test:responsive": "playwright test --config=playwright.config.mjs",
    "test:e2e:pilot": "playwright test --config=e2e-pilot.config.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/pro-components": "3.1.15-9",
    "@uiw/react-md-editor": "^4.1.1",
    "antd": "6.7.0",
    "qrcode.react": "^4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "8.2.4"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.0.2",
    "playwright": "1.62.1",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  }
}
